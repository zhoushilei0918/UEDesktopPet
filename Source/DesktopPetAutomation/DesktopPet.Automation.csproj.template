<Project Sdk="Microsoft.NET.Sdk">
  <!-- DesktopPet 自动生成的 UAT 接入；打包时由 UAT 注入引擎目录，IDE 从 UE 生成的同名 .props 读取。 -->
  <Import Project="$(MSBuildProjectFullPath).props" Condition="'$(EngineDir)' == '' and Exists('$(MSBuildProjectFullPath).props')" />
  <Import Project="$(EngineDir)/Source/Programs/Shared/UnrealEngine.csproj.props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>DesktopPet.Automation</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Nullable>disable</Nullable>
    <OutputPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../Intermediate/DesktopPetAutomation/bin'))</OutputPath>
    <BaseIntermediateOutputPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../Intermediate/DesktopPetAutomation/obj/'))</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- 插件移除后生成入口仍可为空编译，避免残留入口阻断项目打包。 -->
    <Compile Include="__PET_SOURCE__" Condition="Exists('__PET_SOURCE__')" />
    <ProjectReference Include="$(EngineDir)/Source/Programs/AutomationTool/AutomationUtils/AutomationUtils.Automation.csproj" />
    <ProjectReference Include="$(EngineDir)/Source/Programs/Shared/EpicGames.Core/EpicGames.Core.csproj" />
    <ProjectReference Include="$(EngineDir)/Source/Programs/UnrealBuildTool/UnrealBuildTool.csproj" />
  </ItemGroup>
</Project>
