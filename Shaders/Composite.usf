// 保留 CPU 合成器的运算次序；precise 防止驱动把分离的乘加合并后改变边缘取整。
#include "/Engine/Public/Platform.ush"
Texture2D<float4> FinalColor;
Texture2D<float> InverseOpacity;
Texture2D<float4> UIBytes;
RWStructuredBuffer<uint> PetOutput;
StructuredBuffer<uint> PetInput;
RWStructuredBuffer<uint2> PackedOutput;
int2 OutputSize;
int SampleScale;
float InverseSamples;
float ExposureScale;
float AdditiveStrength;
float Sharpness;
uint PreserveAdditive;
uint HasUI;

// 与 UE 5.8 Core/Math/Color.cpp 的 stb/rygorous sRGB8 查表相同，避免改用 pow 造成颜色量化差异。
// 原算法：https://gist.github.com/rygorous/2203834
static const uint PetSRGBTable[104]={
    0x0073000d,0x007a000d,0x0080000d,0x0087000d,0x008d000d,0x0094000d,0x009a000d,0x00a1000d,
    0x00a7001a,0x00b4001a,0x00c1001a,0x00ce001a,0x00da001a,0x00e7001a,0x00f4001a,0x0101001a,
    0x010e0033,0x01280033,0x01410033,0x015b0033,0x01750033,0x018f0033,0x01a80033,0x01c20033,
    0x01dc0067,0x020f0067,0x02430067,0x02760067,0x02aa0067,0x02dd0067,0x03110067,0x03440067,
    0x037800ce,0x03df00ce,0x044600ce,0x04ad00ce,0x051400ce,0x057b00c5,0x05dd00bc,0x063b00b5,
    0x06970158,0x07420142,0x07e30130,0x087b0120,0x090b0112,0x09940106,0x0a1700fc,0x0a9500f2,
    0x0b0f01cb,0x0bf401ae,0x0ccb0195,0x0d950180,0x0e56016e,0x0f0d015e,0x0fbc0150,0x10630143,
    0x11070264,0x1238023e,0x1357021d,0x14660201,0x156601e9,0x165a01d3,0x174401c0,0x182401af,
    0x18fe0331,0x1a9602fe,0x1c1502d2,0x1d7e02ad,0x1ed4028d,0x201a0270,0x21520256,0x227d0240,
    0x239f0443,0x25c003fe,0x27bf03c4,0x29a10392,0x2b6a0367,0x2d1d0341,0x2ebe031f,0x304d0300,
    0x31d105b0,0x34a80555,0x37520507,0x39d504c5,0x3c37048b,0x3e7c0458,0x40a8042a,0x42bd0401,
    0x44c20798,0x488e071e,0x4c1c06b6,0x4f76065d,0x52a50610,0x55ac05cc,0x5892058f,0x5b590559,
    0x5e0c0a23,0x631c0980,0x67db08f6,0x6c55087f,0x70940818,0x74a007bd,0x787d076c,0x7c330723
};
uint PetSRGB(float Value)
{
    Value=!(Value>asfloat(114u<<23))?asfloat(114u<<23):min(Value,asfloat(0x3f7fffff));
    uint Bits=asuint(Value),Table=PetSRGBTable[(Bits-(114u<<23))>>20];
    return (((Table>>16)<<9)+(Table&65535)*((Bits>>12)&255))>>16;
}
uint3 PetSRGB3(float3 Value){return uint3(PetSRGB(Value.r),PetSRGB(Value.g),PetSRGB(Value.b));}
uint PetPack(uint4 C){return C.b|(C.g<<8)|(C.r<<16)|(C.a<<24);}
uint4 PetUnpack(uint V){return uint4((V>>16)&255,(V>>8)&255,V&255,V>>24);}
uint PetRound(float Value){return (uint)floor(Value+0.5);}
uint3 PetRound3(float3 Value){return (uint3)floor(Value+0.5);}

[numthreads(8,8,1)]
void ResolveCS(uint3 Id:SV_DispatchThreadID)
{
    if(any(Id.xy>=(uint2)OutputSize))return;
    precise float3 Sum=0;precise float Coverage=0;
    [loop]for(int V=0;V<SampleScale;++V)[loop]for(int U=0;U<SampleScale;++U)
    {
        int2 P=int2(Id.xy)*SampleScale+int2(U,V);
        Sum=Sum+FinalColor.Load(int3(P,0)).rgb;
        Coverage=Coverage+saturate(1.0-InverseOpacity.Load(int3(P,0)));
    }
    Sum=Sum*ExposureScale;precise float A=saturate(Coverage*InverseSamples);
    uint3 RGB=0;
    if(A>0.00001){precise float Reciprocal=1.0/A;RGB=PetSRGB3(Sum*Reciprocal);}
    else if(PreserveAdditive)
    {
        uint3 Glow=PetSRGB3(Sum);
        precise float Strength=max(Glow.r,max(Glow.g,Glow.b))/255.0;
        A=saturate(Strength*AdditiveStrength);
        if(A>0.00001)RGB=min(255u,PetRound3(float3(Glow)/A));
    }
    uint Alpha=PetRound(A*255.0);
    PetOutput[Id.y*OutputSize.x+Id.x]=PetPack(uint4(min(Alpha,PetRound3(float3(RGB)*A)),Alpha));
}

[numthreads(8,8,1)]
void FinishCS(uint3 Id:SV_DispatchThreadID)
{
    if(any(Id.xy>=(uint2)OutputSize))return;
    uint I=Id.y*OutputSize.x+Id.x;
    uint4 C=PetUnpack(PetInput[I]);uint SceneA=C.a;
    if(Sharpness>0&&C.a==255&&all(Id.xy>0)&&all(Id.xy<(uint2)OutputSize-1))
    {
        uint4 L=PetUnpack(PetInput[I-1]),R=PetUnpack(PetInput[I+1]);
        uint4 T=PetUnpack(PetInput[I-OutputSize.x]),B=PetUnpack(PetInput[I+OutputSize.x]);
        if(L.a==255&&R.a==255&&T.a==255&&B.a==255)
        {
            precise float3 Detail=float3(C.rgb)-float3(L.rgb+R.rgb+T.rgb+B.rgb)*0.25;
            precise float3 Value=float3(C.rgb)+clamp(Detail,-24.0,24.0)*Sharpness;
            C.rgb=PetRound3(clamp(Value,0.0,255.0));
        }
    }
    if(HasUI)
    {
        uint4 U=(uint4)floor(UIBytes.Load(int3(Id.xy,0))*255.0+0.5);
        precise float Remain=1.0-float(U.a)/255.0;
        precise float4 Mixed=float4(U)+float4(C)*Remain;
        C.a=min(255u,PetRound(Mixed.a));C.rgb=min(C.a,PetRound3(max(0.0,Mixed.rgb)));
    }
    PackedOutput[I]=uint2(PetPack(C),SceneA);
}
